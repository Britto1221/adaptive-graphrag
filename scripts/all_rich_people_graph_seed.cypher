  {rank: 29, name: "Dieter Schwarz", birthYear: 1939, country: "Germany", estimatedNetWorthUSDBillions: 67.2, sourceOfWealth: "Retail", companies: ["Schwarz Group", "Lidl", "Kaufland"], roles: ["Owner of Schwarz Group", "Retail entrepreneur"], industries: ["Discount retail", "Hypermarkets", "Logistics", "Food production", "Recycling", "Technology"], relatedPeople: ["Rob Walton", "Jim Walton", "Alice Walton", "Jeff Bezos", "Amancio Ortega"], relationshipTypes: ["OWNS_SUBSIDIARY", "COMPETES_WITH"], companyRelationships: ["Schwarz Group competes with Walmart, Amazon, Aldi, Carrefour, and other retailers in various markets.", "Lidl and Kaufland depend on large networks of food producers, consumer-goods suppliers, logistics providers, property owners, and technology partners.", "The group's private structure makes current ownership and valuation less transparent than publicly traded retailers."]},
  {rank: 30, name: "German Larrea Mota Velasco And Family", birthYear: 1953, country: "Mexico", estimatedNetWorthUSDBillions: 67.1, sourceOfWealth: "Mining", companies: ["Grupo Mexico", "Southern Copper", "Grupo Mexico Transportes"], roles: ["Chairman, President and CEO of Grupo Mexico", "Controlling shareholder"], industries: ["Mining", "Copper", "Rail transport", "Infrastructure", "Industrial materials"], relatedPeople: ["Carlos Slim Helu"], relationshipTypes: ["CONTROLS", "OWNS_SUBSIDIARY", "SUPPLIES_TO"], companyRelationships: ["Grupo Mexico controls Southern Copper through corporate ownership.", "Grupo Mexico's mining businesses sell copper and other materials into global industrial supply chains.", "Its transportation businesses support freight movement and connect mining, manufacturing, and export markets."]}
] AS rows
UNWIND rows AS row
MERGE (p:Person {name: row.name})
SET p.rank = row.rank,
    p.birthYear = row.birthYear,
    p.country = row.country,
    p.estimatedNetWorthUSDBillions = row.estimatedNetWorthUSDBillions,
    p.sourceOfWealth = row.sourceOfWealth,
    p.csvCompanies = row.companies,
    p.csvRoles = row.roles,
    p.csvIndustries = row.industries,
    p.csvRelationshipTypes = row.relationshipTypes,
    p.updatedFrom = "csv_plus_text_seed"
FOREACH (companyName IN row.companies |
  MERGE (c:Company {name: companyName})
  MERGE (p)-[:ASSOCIATED_WITH]->(c)
)
FOREACH (roleName IN row.roles |
  MERGE (r:Role {name: roleName})
  MERGE (p)-[:HAS_ROLE]->(r)
)
FOREACH (industryName IN row.industries |
  MERGE (i:Industry {name: industryName})
  MERGE (p)-[:HAS_BUSINESS_INTEREST_IN]->(i)
)
FOREACH (otherName IN row.relatedPeople |
  MERGE (other:Person {name: otherName})
  MERGE (p)-[br:BUSINESS_RELATED_TO {source: "csv.relatedPeople"}]->(other)
  SET br.relationshipTypes = row.relationshipTypes
);

