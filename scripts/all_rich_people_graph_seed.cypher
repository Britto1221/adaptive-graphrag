WITH rel WHERE size(rel.people) > 1
UNWIND range(0, size(rel.people) - 2) AS i
UNWIND range(i + 1, size(rel.people) - 1) AS j
MATCH (p1:Person {name: rel.people[i]})
MATCH (p2:Person {name: rel.people[j]})
MERGE (p1)-[r:BUSINESS_RELATED_TO {relationship_id: rel.id}]->(p2)
SET r.relationship_type = rel.relationship_type,
    r.description = rel.description,
    r.source_label = rel.source_label;

WITH [
  {id: "REL-001", relationship_type: "INVESTED_IN", applies_to: "2015-01-20", source_label: "Reuters", description: "Alphabet/Google, SpaceX, Larry Page, Sergey Brin, Elon Musk are connected through a INVESTED_IN relationship. Google and Fidelity invested about $1 billion in SpaceX in January 2015. The two investors collectively received just under 10 percent at the time.", people: ["Larry Page", "Sergey Brin", "Elon Musk"], companies: ["Alphabet/Google", "SpaceX", "Alphabet", "Google"], entities: ["Alphabet/Google", "SpaceX", "Larry Page", "Sergey Brin", "Elon Musk"]},
  {id: "REL-002", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "NVIDIA Newsroom and Google Cloud", description: "Google Cloud, NVIDIA, Larry Page, Sergey Brin, Jensen Huang are connected through a PARTNERED_WITH relationship. Google Cloud and NVIDIA have repeatedly expanded their partnership in AI infrastructure, software, accelerated computing, models, and developer tools.", people: ["Larry Page", "Sergey Brin", "Jensen Huang"], companies: ["Google Cloud", "NVIDIA"], entities: ["Google Cloud", "NVIDIA", "Larry Page", "Sergey Brin", "Jensen Huang"]},
  {id: "REL-003", relationship_type: "PARTNERED_WITH", applies_to: "2010-2026", source_label: "AWS and NVIDIA", description: "AWS, NVIDIA, Jeff Bezos, Jensen Huang are connected through a PARTNERED_WITH relationship. AWS and NVIDIA have collaborated since 2010 on GPU-accelerated cloud services. AWS announced that beginning in 2026 it would add more than one million NVIDIA GPUs across global cloud regions.", people: ["Jeff Bezos", "Jensen Huang"], companies: ["AWS", "NVIDIA"], entities: ["AWS", "NVIDIA", "Jeff Bezos", "Jensen Huang"]},
  {id: "REL-004", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "NVIDIA Newsroom", description: "Oracle, NVIDIA, Larry Ellison, Jensen Huang are connected through a PARTNERED_WITH relationship. Oracle and NVIDIA collaborate on accelerated computing, Oracle Cloud Infrastructure, enterprise AI, agentic AI inference, and large AI systems.", people: ["Larry Ellison", "Jensen Huang"], companies: ["Oracle", "NVIDIA"], entities: ["Oracle", "NVIDIA", "Larry Ellison", "Jensen Huang"]},
  {id: "REL-005", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "Dell Technologies and NVIDIA", description: "Dell Technologies, NVIDIA, Michael Dell, Jensen Huang are connected through a PARTNERED_WITH relationship. Dell Technologies and NVIDIA jointly offer the Dell AI Factory with NVIDIA, combining Dell infrastructure with NVIDIA computing, networking, and software.", people: ["Michael Dell", "Jensen Huang"], companies: ["Dell Technologies", "NVIDIA"], entities: ["Dell Technologies", "NVIDIA", "Michael Dell", "Jensen Huang"]},
  {id: "REL-006", relationship_type: "LONG_TERM_INFRASTRUCTURE_PARTNERSHIP", applies_to: "2026-02-17", source_label: "Meta Newsroom", description: "Meta, NVIDIA, Mark Zuckerberg, Jensen Huang are connected through a LONG_TERM_INFRASTRUCTURE_PARTNERSHIP relationship. Meta and NVIDIA announced a multi-year strategic infrastructure partnership in February 2026 to support AI-optimized data centers, training, inference, networking, and software.", people: ["Mark Zuckerberg", "Jensen Huang"], companies: ["Meta", "NVIDIA"], entities: ["Meta", "NVIDIA", "Mark Zuckerberg", "Jensen Huang"]},
  {id: "REL-007", relationship_type: "INVESTED_IN", applies_to: "2020-04-21", source_label: "Meta Newsroom", description: "Meta, Jio Platforms, Mark Zuckerberg, Mukesh Ambani are connected through a INVESTED_IN relationship. Facebook, now Meta, announced a $5.7 billion investment in Jio Platforms in April 2020 and became its largest minority shareholder at the time.", people: ["Mark Zuckerberg", "Mukesh Ambani"], companies: ["Meta", "Jio Platforms"], entities: ["Meta", "Jio Platforms", "Mark Zuckerberg", "Mukesh Ambani"]},
  {id: "REL-008", relationship_type: "OWNS_STAKE_IN", applies_to: "2020-08-05", source_label: "Google India Blog", description: "Google, Jio Platforms, Larry Page, Sergey Brin, Mukesh Ambani are connected through a OWNS_STAKE_IN relationship. Google announced a $4.5 billion investment for a 7.73 percent stake in Jio Platforms and a commercial agreement to develop an affordable Android-based smartphone.", people: ["Larry Page", "Sergey Brin", "Mukesh Ambani"], companies: ["Google", "Jio Platforms"], entities: ["Google", "Jio Platforms", "Larry Page", "Sergey Brin", "Mukesh Ambani"]},
  {id: "REL-009", relationship_type: "USES_CLOUD_AND_AI_SERVICES_FROM", applies_to: "2021-2026", source_label: "Google Cloud", description: "LVMH, Google Cloud, Bernard Arnault, Larry Page, Sergey Brin are connected through a USES_CLOUD_AND_AI_SERVICES_FROM relationship. LVMH has worked with Google Cloud to build a secure data and AI foundation serving luxury brands across the LVMH group.", people: ["Larry Page", "Sergey Brin"], companies: ["LVMH", "Google Cloud", "Bernard Arnault"], entities: ["LVMH", "Google Cloud", "Bernard Arnault", "Larry Page", "Sergey Brin"]},
  {id: "REL-010", relationship_type: "STRATEGIC_TECHNOLOGY_PARTNERSHIP", applies_to: "2018-2024", source_label: "Microsoft", description: "Walmart, Microsoft, Walton family, Bill Gates, Steve Ballmer are connected through a STRATEGIC_TECHNOLOGY_PARTNERSHIP relationship. Walmart and Microsoft announced a five-year strategic partnership in 2018 covering cloud, AI, and Internet of Things technologies. Microsoft later described itself as a preferred and strategic cloud provider for Walmart.", people: ["Rob Walton And Family", "Jim Walton And Family", "Alice Walton", "Bill Gates", "Steve Ballmer"], companies: ["Walmart", "Microsoft"], entities: ["Walmart", "Microsoft", "Walton family", "Bill Gates", "Steve Ballmer"]},
  {id: "REL-011", relationship_type: "CLOUD_PROVIDER_AND_INVESTOR", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "Oracle, TikTok USDS, ByteDance, Larry Ellison, Zhang Yiming are connected through a CLOUD_PROVIDER_AND_INVESTOR relationship. TikTok USDS Joint Venture states that U.S. user data and its recommendation algorithm are protected in Oracle's secure U.S. cloud. Oracle is one of three managing investors, each holding 15 percent.", people: ["Larry Ellison", "Zhang Yiming"], companies: ["Oracle", "TikTok USDS", "ByteDance"], entities: ["Oracle", "TikTok USDS", "ByteDance", "Larry Ellison", "Zhang Yiming"]},
  {id: "REL-012", relationship_type: "OWNS_STAKE_IN", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "ByteDance, TikTok USDS, Zhang Yiming are connected through a OWNS_STAKE_IN relationship. ByteDance retains a 19.9 percent stake in TikTok USDS Joint Venture.", people: ["Zhang Yiming"], companies: ["ByteDance", "TikTok USDS"], entities: ["ByteDance", "TikTok USDS", "Zhang Yiming"]},
  {id: "REL-013", relationship_type: "INVESTED_IN", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "Dell Family Office, TikTok USDS, Michael Dell, Zhang Yiming are connected through a INVESTED_IN relationship. Dell Family Office is listed as a member of the TikTok USDS Joint Venture investor consortium.", people: ["Michael Dell", "Zhang Yiming"], companies: ["Dell Family Office", "TikTok USDS"], entities: ["Dell Family Office", "TikTok USDS", "Michael Dell", "Zhang Yiming"]},
  {id: "REL-014", relationship_type: "EARLY_INVESTOR_AND_CONSORTIUM_MEMBER", applies_to: "Pre-2026 and 2026-01-23", source_label: "Forbes, Reuters, and TikTok Newsroom", description: "Susquehanna International Group, ByteDance, TikTok USDS, Jeff Yass, Zhang Yiming are connected through a EARLY_INVESTOR_AND_CONSORTIUM_MEMBER relationship. Susquehanna was an early investor in ByteDance. A Susquehanna affiliate is also part of the TikTok USDS investor consortium, and a Susquehanna managing director serves on its board.", people: ["Jeff Yass", "Zhang Yiming"], companies: ["Susquehanna International Group", "ByteDance", "TikTok USDS"], entities: ["Susquehanna International Group", "ByteDance", "TikTok USDS", "Jeff Yass", "Zhang Yiming"]},
  {id: "REL-015", relationship_type: "CHIP_SUPPLY_AGREEMENT", applies_to: "2025-07-28", source_label: "Reuters", description: "Tesla, Samsung Electronics, Elon Musk are connected through a CHIP_SUPPLY_AGREEMENT relationship. Tesla and Samsung Electronics entered a $16.5 billion semiconductor supply agreement under which Samsung's Texas facility is expected to produce Tesla's next-generation AI6 chips.", people: ["Elon Musk"], companies: ["Tesla", "Samsung Electronics"], entities: ["Tesla", "Samsung Electronics", "Elon Musk"]},
  {id: "REL-016", relationship_type: "SUPPLIER_RELATIONSHIP", applies_to: "Historical and ongoing by product generation", source_label: "Reuters and display-industry reporting", description: "Apple, Samsung Display, Samsung Electronics are connected through a SUPPLIER_RELATIONSHIP relationship. Samsung Display has supplied OLED display panels used in Apple products. This is an example of two companies that compete in consumer electronics while also maintaining a supplier-customer relationship.", people: [], companies: ["Apple", "Samsung Display", "Samsung Electronics"], entities: ["Apple", "Samsung Display", "Samsung Electronics"]},
  {id: "REL-017", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "Walmart, Amazon, Walton family, Jeff Bezos are connected through a COMPETES_WITH relationship. Walmart and Amazon compete in physical retail, e-commerce, advertising, logistics, online marketplaces, subscription programs, and delivery services.", people: ["Rob Walton And Family", "Jim Walton And Family", "Alice Walton", "Jeff Bezos"], companies: ["Walmart", "Amazon"], entities: ["Walmart", "Amazon", "Walton family", "Jeff Bezos"]},
  {id: "REL-018", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "SpaceX, Blue Origin, Elon Musk, Jeff Bezos are connected through a COMPETES_WITH relationship. SpaceX and Blue Origin compete in commercial launch services, reusable rockets, space infrastructure, government contracts, and long-term human-spaceflight ambitions.", people: ["Elon Musk", "Jeff Bezos"], companies: ["SpaceX", "Blue Origin"], entities: ["SpaceX", "Blue Origin", "Elon Musk", "Jeff Bezos"]},
  {id: "REL-019", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "Google/YouTube, Meta/Instagram, ByteDance/TikTok are connected through a COMPETES_WITH relationship. YouTube, Instagram, and TikTok compete for users, creators, advertising budgets, short-form video engagement, and recommendation-driven content discovery.", people: [], companies: ["Google/YouTube", "Meta/Instagram", "ByteDance/TikTok", "Google", "YouTube", "Meta", "Instagram", "ByteDance", "TikTok"], entities: ["Google/YouTube", "Meta/Instagram", "ByteDance/TikTok"]},
  {id: "REL-020", relationship_type: "SHARED_FAMILY_OWNERSHIP", applies_to: "Ongoing", source_label: "Forbes company and billionaire profiles", description: "Charles Koch family, Julia Koch family, Koch Industries are connected through a SHARED_FAMILY_OWNERSHIP relationship. Charles Koch's family and Julia Koch's family are linked through large family ownership interests in privately held Koch Industries.", people: ["Charles Koch And Family", "Julia Koch And Family"], companies: ["Koch Industries"], entities: ["Charles Koch family", "Julia Koch family", "Koch Industries"]}
] AS rels
UNWIND rels AS rel
WITH rel WHERE size(rel.companies) > 1
UNWIND range(0, size(rel.companies) - 2) AS i
UNWIND range(i + 1, size(rel.companies) - 1) AS j
MATCH (c1:Company {name: rel.companies[i]})
MATCH (c2:Company {name: rel.companies[j]})
MERGE (c1)-[r:BUSINESS_RELATIONSHIP {relationship_id: rel.id}]->(c2)
SET r.relationship_type = rel.relationship_type,
    r.description = rel.description,
    r.source_label = rel.source_label;

MATCH (p:Person) WITH count(p) AS people
MATCH (c:Company) WITH people, count(c) AS companies
MATCH (i:Industry) WITH people, companies, count(i) AS industries
MATCH (f:RelationshipFact)
RETURN people, companies, industries, count(f) AS relationshipFacts;
