  {rank: 30, name: "German Larrea Mota Velasco And Family", birthYear: 1953, country: "Mexico", estimatedNetWorthUSDBillions: 67.1, sourceOfWealth: "Mining", companies: ["Grupo Mexico", "Southern Copper", "Grupo Mexico Transportes"], roles: ["Chairman, President and CEO of Grupo Mexico", "Controlling shareholder"], industries: ["Mining", "Copper", "Rail transport", "Infrastructure", "Industrial materials"], relatedPeople: ["Carlos Slim Helu"], relationshipTypes: ["CONTROLS", "OWNS_SUBSIDIARY", "SUPPLIES_TO"], companyRelationships: ["Grupo Mexico controls Southern Copper through corporate ownership.", "Grupo Mexico's mining businesses sell copper and other materials into global industrial supply chains.", "Its transportation businesses support freight movement and connect mining, manufacturing, and export markets."]}
] AS rows
UNWIND rows AS row
MATCH (p:Person {name: row.name})
UNWIND range(0, size(row.companyRelationships) - 1) AS idx
WITH row, p, idx WHERE idx >= 0
MERGE (f:RelationshipFact {id: "CSV-REL-" + toString(row.rank) + "-" + toString(idx + 1)})
SET f.description = row.companyRelationships[idx],
    f.source = "csv.companyRelationships",
    f.person = row.name,
    f.relationshipTypes = row.relationshipTypes
MERGE (p)-[:HAS_RELATIONSHIP_FACT]->(f);

WITH [
  {id: "PROFILE-01", person: "Elon Musk", description: "Elon Musk was ranked number 1 in the dataset snapshot, with an estimated net worth of $839 billion. The ranking associated Elon Musk with United States, and the recorded birth year is 1971. The primary source of wealth is described as Tesla and SpaceX. The main companies and organizations connected to this fortune are Tesla, SpaceX, Starlink, X, xAI, Neuralink, and The Boring Company. Elon Musk is an entrepreneur whose wealth is primarily linked to ownership stakes in Tesla and SpaceX. Tesla develops electric vehicles, battery-storage systems, charging infrastructure, solar products, artificial-intelligence systems, and humanoid robotics. SpaceX develops reusable rockets, spacecraft, satellite-launch services, and the Starlink satellite-internet network. Musk also controls X, founded xAI, and is associated with Neuralink and The Boring Company. His business network spans automobiles, energy, space transportation, satellite communications, social media, artificial intelligence, brain-computer interfaces, and infrastructure. The wider company network connected to Elon Musk includes several important relationships. Google and Fidelity invested about $1 billion in SpaceX in 2015, creating an investment relationship between Alphabet and SpaceX. Tesla signed a long-term semiconductor supply agreement with Samsung Electronics for next-generation AI chips. Finally, Tesla competes with global automobile manufacturers while also purchasing chips, batteries, displays, and manufacturing equipment from external suppliers.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-02", person: "Larry Page", description: "Larry Page was ranked number 2 in the dataset snapshot, with an estimated net worth of $257 billion. The ranking associated Larry Page with United States, and the recorded birth year is 1973. The primary source of wealth is described as Google. The main companies and organizations connected to this fortune are Google and Alphabet. Larry Page co-founded Google with Sergey Brin. Google later became the main operating company inside Alphabet. Alphabet's businesses include Google Search, advertising, YouTube, Android, Chrome, Google Cloud, Maps, Google Play, hardware, artificial intelligence research, autonomous-driving company Waymo, and other long-term projects. Page served as Google's chief executive and later as Alphabet's chief executive. Much of his wealth is tied to Alphabet shares. The wider company network connected to Larry Page includes several important relationships. Larry Page and Sergey Brin are connected through their joint founding of Google and continuing ownership in Alphabet. Alphabet invested in Elon Musk's SpaceX. Google Cloud has a long-running technology partnership with NVIDIA. Finally, Google acquired a 7.73 percent stake in Mukesh Ambani's Jio Platforms in 2020.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-03", person: "Sergey Brin", description: "Sergey Brin was ranked number 3 in the dataset snapshot, with an estimated net worth of $237 billion. The ranking associated Sergey Brin with United States, and the recorded birth year is 1973. The primary source of wealth is described as Google. The main companies and organizations connected to this fortune are Google and Alphabet. Sergey Brin co-founded Google with Larry Page after the two developed an internet search system at Stanford University. Google's search and advertising businesses became the foundation of Alphabet. Brin served as president of Alphabet and has remained closely associated with the company's technology and artificial-intelligence activities. His fortune is largely derived from Alphabet shares. Through Alphabet, Brin is economically connected to Google Cloud, YouTube, Android, Waymo, DeepMind, and other Alphabet subsidiaries. The wider company network connected to Sergey Brin includes several important relationships. Sergey Brin and Larry Page are co-founders of Google. Alphabet's investment in SpaceX links Brin's main source of wealth to Elon Musk's aerospace company. Google Cloud's collaboration with NVIDIA connects Alphabet to Jensen Huang's company. Finally, Google's investment in Jio Platforms connects Alphabet to Mukesh Ambani's Reliance group.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-04", person: "Jeff Bezos", description: "Jeff Bezos was ranked number 4 in the dataset snapshot, with an estimated net worth of $224 billion. The ranking associated Jeff Bezos with United States, and the recorded birth year is 1964. The primary source of wealth is described as Amazon. The main companies and organizations connected to this fortune are Amazon, Amazon Web Services, Blue Origin, and The Washington Post. Jeff Bezos founded Amazon as an online bookstore and expanded it into a global e-commerce, logistics, digital-media, advertising, hardware, and cloud-computing company. Amazon Web Services, known as AWS, provides cloud infrastructure, databases, storage, analytics, artificial intelligence, and enterprise software. Bezos also founded Blue Origin, a private space company, and owns The Washington Post through a private holding company. His wealth remains strongly tied to Amazon shares. The wider company network connected to Jeff Bezos includes several important relationships. AWS and NVIDIA have collaborated since 2010 on GPU-accelerated cloud computing. AWS offers NVIDIA-based infrastructure for artificial-intelligence training and inference. Amazon competes with Walmart in retail, with Microsoft and Google in cloud computing, and with other logistics and advertising platforms. Finally, Blue Origin competes with Elon Musk's SpaceX in launch services and space technology.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-05", person: "Mark Zuckerberg", description: "Mark Zuckerberg was ranked number 5 in the dataset snapshot, with an estimated net worth of $222 billion. The ranking associated Mark Zuckerberg with United States, and the recorded birth year is 1984. The primary source of wealth is described as Facebook. The main companies and organizations connected to this fortune are Meta Platforms, Facebook, Instagram, WhatsApp, Messenger, and Reality Labs. Mark Zuckerberg co-founded Facebook and is the founder and chief executive of Meta Platforms. Meta owns Facebook, Instagram, WhatsApp, Messenger, and Reality Labs. Its revenue is primarily generated through digital advertising, while the company also invests heavily in artificial intelligence, data centers, virtual reality, augmented reality, and wearable devices. Zuckerberg's wealth is mainly tied to his ownership of Meta shares. The wider company network connected to Mark Zuckerberg includes several important relationships. Meta invested $5.7 billion in Jio Platforms in 2020 and became its largest minority shareholder at the time. Meta and NVIDIA announced a long-term infrastructure partnership for AI-optimized data centers in 2026. Finally, Meta competes with Google's YouTube and advertising businesses, ByteDance's TikTok, and other social and digital-advertising platforms.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-06", person: "Larry Ellison", description: "Larry Ellison was ranked number 6 in the dataset snapshot, with an estimated net worth of $190 billion. The ranking associated Larry Ellison with United States, and the recorded birth year is 1944. The primary source of wealth is described as Oracle. The main companies and organizations connected to this fortune are Oracle Corporation. Larry Ellison co-founded Oracle, one of the world's largest enterprise-software and database companies. Oracle sells database software, cloud infrastructure, enterprise applications, healthcare technology, and artificial-intelligence computing services. Ellison has served as Oracle's chief executive, executive chairman, and chief technology officer. His wealth is primarily tied to his large ownership position in Oracle. The wider company network connected to Larry Ellison includes several important relationships. Oracle and NVIDIA collaborate on accelerated computing, cloud infrastructure, agentic AI, and large-scale AI systems. Oracle is a managing investor in TikTok USDS Joint Venture and holds a 15 percent stake in that U.S. entity. TikTok USDS stores protected U.S. user data and its recommendation algorithm in Oracle's secure U.S. cloud environment. Finally, Oracle's TikTok relationship connects Ellison's company to ByteDance founder Zhang Yiming and to Susquehanna investor Jeff Yass.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-07", person: "Bernard Arnault And Family", description: "Bernard Arnault And Family was ranked number 7 in the dataset snapshot, with an estimated net worth of $171 billion. The ranking associated Bernard Arnault And Family with France, and the recorded birth year is 1949. The primary source of wealth is described as LVMH. The main companies and organizations connected to this fortune are LVMH, Louis Vuitton, Dior, Moet Hennessy, Tiffany & Co., Sephora, Bulgari, and other luxury brands. Bernard Arnault built his fortune through LVMH, the world's largest luxury-goods group. LVMH operates brands across fashion, leather goods, wines and spirits, perfumes, cosmetics, watches, jewelry, selective retailing, and hospitality. Arnault serves as the group's controlling leader, and members of his family hold important roles across the wider business. The family's wealth is closely linked to ownership of LVMH. The wider company network connected to Bernard Arnault And Family includes several important relationships. LVMH has worked with Google Cloud to build a group-wide data and artificial-intelligence foundation. The LVMH-Google Cloud relationship connects Bernard Arnault's luxury group to Alphabet, the company associated with Larry Page and Sergey Brin. Finally, LVMH owns Tiffany & Co. and numerous other brands through acquisition and subsidiary relationships. For vector retrieval, this profile is relevant to questions about Bernard Arnault And Family, LVMH, LVMH, Louis Vuitton, Dior, Moet Hennessy, Tiffany & Co., Sephora, Bulgari, and other luxury brands, billionaire rankings, ownership, investments, partnerships, competition, suppliers, subsidiaries, and cross-company relationships.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-08", person: "Jensen Huang", description: "Jensen Huang was ranked number 8 in the dataset snapshot, with an estimated net worth of $154 billion. The ranking associated Jensen Huang with United States, and the recorded birth year is 1963. The primary source of wealth is described as Semiconductors. The main companies and organizations connected to this fortune are NVIDIA. Jensen Huang co-founded NVIDIA and serves as its chief executive. NVIDIA designs graphics processors, data-center accelerators, networking systems, artificial-intelligence software, robotics platforms, and high-performance computing technology. The company's GPUs and software ecosystem are widely used for AI training and inference. Huang's wealth is largely tied to NVIDIA shares. The wider company network connected to Jensen Huang includes several important relationships. NVIDIA partners with AWS, Google Cloud, Oracle, Dell Technologies, Microsoft Azure, Meta, and many other technology companies. The Dell AI Factory with NVIDIA combines Dell servers and storage with NVIDIA computing and software. Meta and NVIDIA announced a multi-year strategic AI infrastructure partnership in 2026. AWS announced plans to add more than one million NVIDIA GPUs across its global cloud regions beginning in 2026. Finally, Oracle and NVIDIA collaborate on cloud AI infrastructure and enterprise AI services.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-09", person: "Warren Buffett", description: "Warren Buffett was ranked number 9 in the dataset snapshot, with an estimated net worth of $149 billion. The ranking associated Warren Buffett with United States, and the recorded birth year is 1930. The primary source of wealth is described as Berkshire Hathaway. The main companies and organizations connected to this fortune are Berkshire Hathaway. Warren Buffett built his fortune through Berkshire Hathaway, a diversified holding company. Berkshire owns insurance, railroad, energy, manufacturing, retail, industrial, and service businesses and also maintains a large portfolio of public-company investments. Major wholly owned operations have included GEICO, BNSF Railway, Berkshire Hathaway Energy, and numerous manufacturing and consumer businesses. Buffett is known for long-term value investing and capital allocation. The wider company network connected to Warren Buffett includes several important relationships. Berkshire Hathaway connects to many public companies through equity investments, although those holdings change over time. Its insurance operations generate capital that can be invested in operating businesses and public securities. Finally, For retrieval accuracy, current Berkshire portfolio positions should be verified from the latest regulatory filing rather than assumed from older reports.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-10", person: "Amancio Ortega", description: "Amancio Ortega was ranked number 10 in the dataset snapshot, with an estimated net worth of $148 billion. The ranking associated Amancio Ortega with Spain, and the recorded birth year is 1936. The primary source of wealth is described as Zara. The main companies and organizations connected to this fortune are Inditex, Zara, and Pontegadea. Amancio Ortega co-founded the fashion retailer that became Inditex. Inditex operates Zara and other apparel and retail brands. The group became known for rapidly moving designs from development to stores through a tightly coordinated supply chain. Ortega also owns substantial real estate through his investment company Pontegadea. His wealth is primarily connected to his Inditex ownership. The wider company network connected to Amancio Ortega includes several important relationships. Inditex owns Zara and several other retail brands through subsidiary and brand relationships. The company relies on global textile, manufacturing, logistics, property, and technology partners. Finally, Pontegadea invests in commercial real estate and other long-term assets separately from Inditex.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-11", person: "Rob Walton And Family", description: "Rob Walton And Family was ranked number 11 in the dataset snapshot, with an estimated net worth of $146 billion. The ranking associated Rob Walton And Family with United States, and the recorded birth year is 1944. The primary source of wealth is described as Walmart. The main companies and organizations connected to this fortune are Walmart and Walton family holdings. Rob Walton is the eldest son of Walmart founder Sam Walton and a major beneficiary of the Walton family's Walmart ownership. He served for many years as Walmart's chairman. Walmart operates supermarkets, discount stores, warehouse clubs, e-commerce platforms, advertising services, financial services, logistics networks, and international retail businesses. The Walton family's wealth is largely tied to Walmart shares. The wider company network connected to Rob Walton And Family includes several important relationships. Rob Walton, Jim Walton, and Alice Walton are siblings whose fortunes are tied to the same Walmart ownership base. Walmart established a strategic cloud and AI partnership with Microsoft. Finally, Walmart competes directly with Amazon in retail, e-commerce, logistics, advertising, and marketplace services.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-12", person: "Jim Walton And Family", description: "Jim Walton And Family was ranked number 12 in the dataset snapshot, with an estimated net worth of $143 billion. The ranking associated Jim Walton And Family with United States, and the recorded birth year is 1948. The primary source of wealth is described as Walmart. The main companies and organizations connected to this fortune are Walmart and Arvest Bank. Jim Walton is a son of Walmart founder Sam Walton. His wealth is primarily tied to the Walton family's Walmart stake. He has also been associated with Arvest Bank, a regional banking group controlled by the Walton family. Walmart's operations cover physical retail, membership clubs, online commerce, supply-chain infrastructure, advertising, healthcare services, and financial products. The wider company network connected to Jim Walton And Family includes several important relationships. Jim Walton shares a common Walmart ownership connection with Rob Walton and Alice Walton. Walmart's Microsoft partnership links the Walton family's main company to the company historically associated with Bill Gates and Steve Ballmer. Finally, Walmart and Amazon are major competitors in retail and e-commerce.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-13", person: "Michael Dell", description: "Michael Dell was ranked number 13 in the dataset snapshot, with an estimated net worth of $141 billion. The ranking associated Michael Dell with United States, and the recorded birth year is 1965. The primary source of wealth is described as Dell Technologies. The main companies and organizations connected to this fortune are Dell Technologies and Dell Family Office. Michael Dell founded Dell and serves as founder, chairman, and chief executive of Dell Technologies. The company sells personal computers, servers, data-storage systems, networking products, enterprise infrastructure, services, and AI-focused hardware. Dell's wealth is tied to his ownership in Dell Technologies and private investments managed through family-office structures. The wider company network connected to Michael Dell includes several important relationships. Dell Technologies and NVIDIA jointly offer the Dell AI Factory with NVIDIA. Dell Family Office is an investor in TikTok USDS Joint Venture. TikTok USDS creates a corporate connection between Michael Dell's investment organization, Oracle, ByteDance, and a Susquehanna affiliate. Finally, Dell competes and partners with multiple cloud, semiconductor, and enterprise-technology firms.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-14", person: "Alice Walton", description: "Alice Walton was ranked number 14 in the dataset snapshot, with an estimated net worth of $134 billion. The ranking associated Alice Walton with United States, and the recorded birth year is 1949. The primary source of wealth is described as Walmart. The main companies and organizations connected to this fortune are Walmart family holdings and philanthropic organizations. Alice Walton is the daughter of Walmart founder Sam Walton. Unlike her brothers, she has focused much of her public activity on art, philanthropy, healthcare, and cultural institutions. Her fortune is primarily derived from the Walton family's Walmart ownership. She founded the Crystal Bridges Museum of American Art and has supported other educational and healthcare initiatives. The wider company network connected to Alice Walton includes several important relationships. Alice Walton is connected to Rob Walton and Jim Walton through common family ownership of Walmart. Walmart's strategic relationship with Microsoft creates a technology connection to the company associated with Bill Gates and Steve Ballmer. Finally, Walmart competes with Amazon and other global retailers.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-15", person: "Steve Ballmer", description: "Steve Ballmer was ranked number 15 in the dataset snapshot, with an estimated net worth of $126 billion. The ranking associated Steve Ballmer with United States, and the recorded birth year is 1956. The primary source of wealth is described as Microsoft. The main companies and organizations connected to this fortune are Microsoft and the Los Angeles Clippers. Steve Ballmer joined Microsoft in its early years and later served as chief executive. His fortune is largely linked to Microsoft shares. Microsoft develops Windows, Microsoft 365, Azure cloud services, enterprise software, developer tools, gaming products, cybersecurity systems, and artificial-intelligence services. Ballmer later became owner of the Los Angeles Clippers basketball team. The wider company network connected to Steve Ballmer includes several important relationships. Steve Ballmer and Bill Gates are connected through Microsoft's history, ownership, and leadership. Microsoft has a strategic cloud, AI, and technology relationship with Walmart. Finally, Microsoft Azure competes with Amazon Web Services, Google Cloud, and Oracle Cloud while also partnering with many hardware and AI suppliers.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-16", person: "Carlos Slim Helu And Family", description: "Carlos Slim Helu And Family was ranked number 16 in the dataset snapshot, with an estimated net worth of $125 billion. The ranking associated Carlos Slim Helu And Family with Mexico, and the recorded birth year is 1940. The primary source of wealth is described as Telecommunications. The main companies and organizations connected to this fortune are America Movil, Grupo Carso, and Grupo Financiero Inbursa. Carlos Slim built a diversified business group with major interests in telecommunications, infrastructure, construction, retail, mining, real estate, and financial services. America Movil is one of Latin America's largest telecommunications companies. Grupo Carso holds businesses across industrial and commercial sectors, while Grupo Financiero Inbursa provides banking and financial services. The wider company network connected to Carlos Slim Helu And Family includes several important relationships. America Movil operates telecommunications networks and purchases infrastructure, devices, software, and cloud services from global technology suppliers. Grupo Carso acts as a holding company for multiple industrial, retail, and infrastructure businesses. Finally, Slim's group may both partner and compete with technology and telecom companies connected to other billionaires.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-17", person: "Changpeng Zhao", description: "Changpeng Zhao was ranked number 17 in the dataset snapshot, with an estimated net worth of $110 billion. The ranking associated Changpeng Zhao with Canada, and the recorded birth year is 1977. The primary source of wealth is described as Cryptocurrency exchange. The main companies and organizations connected to this fortune are Binance. Changpeng Zhao, commonly known as CZ, founded Binance, a global cryptocurrency exchange and blockchain ecosystem. Binance has offered trading, custody, blockchain infrastructure, token services, and other digital-asset products. Zhao stepped down as chief executive in 2023. His wealth is linked to ownership interests in Binance and cryptocurrency assets. The wider company network connected to Changpeng Zhao includes several important relationships. Binance competes with other cryptocurrency exchanges and interacts with stablecoin issuers such as Tether. Tether's USDT stablecoin is widely used across cryptocurrency markets, creating an operational relationship between exchanges and Tether. Finally, Regulatory status, ownership, and product availability vary by jurisdiction and should be verified for current use.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-18", person: "Michael Bloomberg", description: "Michael Bloomberg was ranked number 18 in the dataset snapshot, with an estimated net worth of $109 billion. The ranking associated Michael Bloomberg with United States, and the recorded birth year is 1942. The primary source of wealth is described as Bloomberg LP. The main companies and organizations connected to this fortune are Bloomberg LP and Bloomberg Philanthropies. Michael Bloomberg co-founded Bloomberg LP, a financial-data, software, media, and analytics company. The Bloomberg Terminal provides market data, news, trading tools, messaging, and analytics to financial institutions and professionals. Bloomberg also served as mayor of New York City and established Bloomberg Philanthropies. His wealth is mainly connected to his ownership of Bloomberg LP. The wider company network connected to Michael Bloomberg includes several important relationships. Bloomberg LP supplies financial information used by banks, brokerages, investment funds, companies, and professional investors. Its products compete with and complement services offered by exchanges, brokers, media companies, and financial-data providers. Finally, Interactive Brokers and Susquehanna operate in financial markets where Bloomberg data and terminals are widely used.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-19", person: "Bill Gates", description: "Bill Gates was ranked number 19 in the dataset snapshot, with an estimated net worth of $108 billion. The ranking associated Bill Gates with United States, and the recorded birth year is 1955. The primary source of wealth is described as Microsoft. The main companies and organizations connected to this fortune are Microsoft, Cascade Investment, and the Gates Foundation. Bill Gates co-founded Microsoft and helped build it into a global software company. Although he has diversified much of his wealth, Microsoft remains the company most closely associated with his fortune. Gates also manages investments through Cascade Investment and is a major philanthropist through the Gates Foundation, which works in global health, development, agriculture, and education. The wider company network connected to Bill Gates includes several important relationships. Bill Gates and Steve Ballmer are connected through Microsoft's founding-era growth and later executive leadership. Microsoft's strategic partnership with Walmart links Gates' historic company to the Walton family's retailer. Finally, Microsoft competes with Amazon, Alphabet, and Oracle in cloud computing and enterprise technology.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-20", person: "Francoise Bettencourt Meyers And Family", description: "Francoise Bettencourt Meyers And Family was ranked number 20 in the dataset snapshot, with an estimated net worth of $100 billion. The ranking associated Francoise Bettencourt Meyers And Family with France, and the recorded birth year is 1953. The primary source of wealth is described as L'Oreal. The main companies and organizations connected to this fortune are L'Oreal and family holding companies. Francoise Bettencourt Meyers is the granddaughter of L'Oreal founder Eugene Schueller and a major beneficiary of the family's ownership in L'Oreal. L'Oreal is one of the world's largest beauty companies, with brands across cosmetics, skincare, haircare, fragrance, and dermatological products. The family exercises its ownership through holding structures and maintains a long-term strategic relationship with L'Oreal. The wider company network connected to Francoise Bettencourt Meyers And Family includes several important relationships. L'Oreal owns and operates a large portfolio of beauty brands through subsidiary and brand relationships. L'Oreal works with retailers, e-commerce companies, advertising platforms, cloud providers, suppliers, and packaging manufacturers. Finally, The company competes with beauty businesses owned by luxury groups, including brands within LVMH.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-21", person: "Mukesh Ambani", description: "Mukesh Ambani was ranked number 21 in the dataset snapshot, with an estimated net worth of $99.7 billion. The ranking associated Mukesh Ambani with India, and the recorded birth year is 1957. The primary source of wealth is described as Diversified. The main companies and organizations connected to this fortune are Reliance Industries, Jio Platforms, Reliance Retail, and energy businesses. Mukesh Ambani leads Reliance Industries, a diversified Indian conglomerate with businesses in energy, petrochemicals, refining, telecommunications, digital services, retail, media, and new-energy technologies. Jio Platforms operates telecommunications and digital businesses, while Reliance Retail is one of India's largest retail operations. Ambani's wealth is primarily tied to Reliance Industries. The wider company network connected to Mukesh Ambani includes several important relationships. Meta invested $5.7 billion in Jio Platforms in 2020. Google invested $4.5 billion for a 7.73 percent stake in Jio Platforms in 2020. Google and Jio agreed to collaborate on an affordable Android-based smartphone. Finally, These transactions connect Mukesh Ambani's Reliance group to Mark Zuckerberg's Meta and to Alphabet, associated with Larry Page and Sergey Brin.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-22", person: "Giancarlo Devasini", description: "Giancarlo Devasini was ranked number 22 in the dataset snapshot, with an estimated net worth of $89.3 billion. The ranking associated Giancarlo Devasini with Italy, and the recorded birth year is 1964. The primary source of wealth is described as Cryptocurrency. The main companies and organizations connected to this fortune are Tether and Bitfinex. Giancarlo Devasini is chairman and a major controlling shareholder of Tether, the issuer of the USDT stablecoin. He has also been associated with Bitfinex, a cryptocurrency exchange. Tether issues tokens designed to track the value of fiat currencies and manages reserves supporting those tokens. Its profitability and scale have made ownership in Tether a major source of Devasini's wealth. The wider company network connected to Giancarlo Devasini includes several important relationships. Tether's USDT is used on cryptocurrency exchanges, including platforms that compete with Binance. Tether and Bitfinex have shared ownership and management links. Finally, A 2026 U.S. securities filing stated that Devasini had greater than 50 percent voting interest in a Tether investment entity involved in that filing.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-23", person: "Thomas Peterffy", description: "Thomas Peterffy was ranked number 23 in the dataset snapshot, with an estimated net worth of $82.9 billion. The ranking associated Thomas Peterffy with United States, and the recorded birth year is 1944. The primary source of wealth is described as Brokerage. The main companies and organizations connected to this fortune are Interactive Brokers. Thomas Peterffy founded Interactive Brokers and serves as chairman. He was an early pioneer in applying computers to securities trading and market making. Interactive Brokers provides electronic brokerage, trading, custody, market access, and investment services to individuals and institutions around the world. Peterffy's wealth is primarily tied to his ownership in Interactive Brokers. The wider company network connected to Thomas Peterffy includes several important relationships. Interactive Brokers connects customers to global exchanges, market makers, clearing systems, and financial-data providers. The firm operates in the same broad financial-market ecosystem as Bloomberg LP and Susquehanna International Group. Finally, It competes with other online brokerages while relying on exchanges, banks, data vendors, and technology providers.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-24", person: "Julia Koch And Family", description: "Julia Koch And Family was ranked number 24 in the dataset snapshot, with an estimated net worth of $81.2 billion. The ranking associated Julia Koch And Family with United States, and the recorded birth year is 1962. The primary source of wealth is described as Koch Industries. The main companies and organizations connected to this fortune are Koch Industries family ownership. Julia Koch and her children inherited a large ownership interest in Koch Industries after the death of her husband, David Koch. Koch Industries is a privately held conglomerate with businesses in manufacturing, chemicals, refining, energy, materials, industrial technology, consumer products, electronics, software, and investments. The family's wealth is tied to private ownership in the group. The wider company network connected to Julia Koch And Family includes several important relationships. Julia Koch's family and Charles Koch's family are connected through shared ownership of Koch Industries. Koch Industries owns and invests in numerous operating companies through subsidiaries and investment arms. Finally, Because Koch Industries is private, current ownership percentages and subsidiary structures should be verified from official company information.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-25", person: "Charles Koch And Family", description: "Charles Koch And Family was ranked number 25 in the dataset snapshot, with an estimated net worth of $73.8 billion. The ranking associated Charles Koch And Family with United States, and the recorded birth year is 1935. The primary source of wealth is described as Koch Industries. The main companies and organizations connected to this fortune are Koch Industries. Charles Koch has led Koch Industries for decades. The company grew from an industrial and energy base into a large private conglomerate operating across refining, chemicals, engineered systems, materials, electronics, software, consumer products, and investment activities. His wealth is tied to the family's ownership of Koch Industries. The wider company network connected to Charles Koch And Family includes several important relationships. Charles Koch and Julia Koch's family are linked through common ownership of Koch Industries. Koch Industries controls multiple subsidiaries and investment businesses. Finally, Its companies buy from, sell to, invest in, and compete with businesses across energy, manufacturing, electronics, software, and consumer markets.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-26", person: "Zhang Yiming", description: "Zhang Yiming was ranked number 26 in the dataset snapshot, with an estimated net worth of $69.3 billion. The ranking associated Zhang Yiming with China, and the recorded birth year is 1983. The primary source of wealth is described as TikTok. The main companies and organizations connected to this fortune are ByteDance, TikTok, Douyin, CapCut, and other digital platforms. Zhang Yiming co-founded ByteDance, the technology company behind TikTok, Douyin, CapCut, and other content and software products. ByteDance became one of the world's most valuable private technology companies by applying recommendation algorithms, advertising technology, and global mobile distribution. Zhang stepped down from day-to-day leadership but remains economically connected through ownership. The wider company network connected to Zhang Yiming includes several important relationships. Susquehanna International Group was an early investor in ByteDance, connecting Zhang Yiming to Jeff Yass. TikTok USDS Joint Venture uses Oracle's secure U.S. cloud environment and has Oracle as a 15 percent managing investor. ByteDance retains 19.9 percent of TikTok USDS Joint Venture. Dell Family Office and a Susquehanna affiliate are members of the TikTok USDS investor consortium. Finally, TikTok competes with Meta's Instagram and Google's YouTube.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-27", person: "Zhong Shanshan", description: "Zhong Shanshan was ranked number 27 in the dataset snapshot, with an estimated net worth of $68.1 billion. The ranking associated Zhong Shanshan with China, and the recorded birth year is 1954. The primary source of wealth is described as Beverages and pharmaceuticals. The main companies and organizations connected to this fortune are Nongfu Spring and Beijing Wantai Biological Pharmacy. Zhong Shanshan founded Nongfu Spring, a major Chinese bottled-water and beverage company. He is also associated with Beijing Wantai Biological Pharmacy, which develops diagnostic products, vaccines, and other biomedical technologies. His fortune is tied to ownership stakes in these publicly traded businesses. The wider company network connected to Zhong Shanshan includes several important relationships. Nongfu Spring operates through beverage manufacturing, packaging, distribution, retail, and logistics relationships. Wantai works within pharmaceutical, diagnostics, research, healthcare, and regulatory ecosystems. Finally, Both companies depend on suppliers, distributors, technology providers, and public-market investors.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-28", person: "Jeff Yass", description: "Jeff Yass was ranked number 28 in the dataset snapshot, with an estimated net worth of $67.4 billion. The ranking associated Jeff Yass with United States, and the recorded birth year is 1958. The primary source of wealth is described as Trading. The main companies and organizations connected to this fortune are Susquehanna International Group. Jeff Yass co-founded Susquehanna International Group, commonly known as SIG, and is a managing director. SIG is active in options trading, market making, quantitative trading, technology, private investments, and venture capital. Yass's fortune is linked to his ownership in SIG and the firm's investments. The wider company network connected to Jeff Yass includes several important relationships. Susquehanna was an early investor in ByteDance, the company founded by Zhang Yiming. Vastmere Strategic Investments, an affiliate of Susquehanna, is part of the TikTok USDS investor consortium. A Susquehanna managing director sits on the TikTok USDS board. Finally, SIG operates in the broader financial-market ecosystem alongside Interactive Brokers and financial-data companies such as Bloomberg LP.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-29", person: "Dieter Schwarz", description: "Dieter Schwarz was ranked number 29 in the dataset snapshot, with an estimated net worth of $67.2 billion. The ranking associated Dieter Schwarz with Germany, and the recorded birth year is 1939. The primary source of wealth is described as Retail. The main companies and organizations connected to this fortune are Schwarz Group, Lidl, and Kaufland. Dieter Schwarz built his wealth through Schwarz Group, the private retail organization that controls Lidl and Kaufland. Lidl is a discount supermarket chain, while Kaufland operates hypermarkets and other large-format retail businesses. The group also has logistics, production, recycling, digital, and technology operations. Schwarz's fortune is tied to private ownership of the group. The wider company network connected to Dieter Schwarz includes several important relationships. Schwarz Group competes with Walmart, Amazon, Aldi, Carrefour, and other retailers in various markets. Lidl and Kaufland depend on large networks of food producers, consumer-goods suppliers, logistics providers, property owners, and technology partners. Finally, The group's private structure makes current ownership and valuation less transparent than publicly traded retailers.", source: "paragraph_corpus_full_profile"},
  {id: "PROFILE-30", person: "German Larrea Mota Velasco And Family", description: "German Larrea Mota Velasco And Family was ranked number 30 in the dataset snapshot, with an estimated net worth of $67.1 billion. The ranking associated German Larrea Mota Velasco And Family with Mexico, and the recorded birth year is 1953. The primary source of wealth is described as Mining. The main companies and organizations connected to this fortune are Grupo Mexico, Southern Copper, and Grupo Mexico Transportes. German Larrea Mota Velasco is chairman, president, and chief executive of Grupo Mexico. The group has major operations in copper mining, transportation, railroads, infrastructure, and related industrial businesses. Grupo Mexico controls Southern Copper and operates important freight-rail businesses. Larrea's wealth is tied to family control of Grupo Mexico. The wider company network connected to German Larrea Mota Velasco And Family includes several important relationships. Grupo Mexico controls Southern Copper through corporate ownership. Grupo Mexico's mining businesses sell copper and other materials into global industrial supply chains. Finally, Its transportation businesses support freight movement and connect mining, manufacturing, and export markets.", source: "paragraph_corpus_full_profile"}
] AS profiles
UNWIND profiles AS profile
MATCH (p:Person {name: profile.person})
MERGE (f:RelationshipFact {id: profile.id})
SET f.description = profile.description,
    f.source = profile.source,
    f.person = profile.person
MERGE (p)-[:HAS_RELATIONSHIP_FACT]->(f)
MERGE (p)-[:HAS_PROFILE_FACT]->(f);

WITH [
  {id: "REL-001", relationship_type: "INVESTED_IN", applies_to: "2015-01-20", source_label: "Reuters", description: "Alphabet/Google, SpaceX, Larry Page, Sergey Brin, Elon Musk are connected through a INVESTED_IN relationship. Google and Fidelity invested about $1 billion in SpaceX in January 2015. The two investors collectively received just under 10 percent at the time.", people: ["Larry Page", "Sergey Brin", "Elon Musk"], companies: ["Alphabet/Google", "SpaceX", "Alphabet", "Google"], entities: ["Alphabet/Google", "SpaceX", "Larry Page", "Sergey Brin", "Elon Musk"]},
  {id: "REL-002", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "NVIDIA Newsroom and Google Cloud", description: "Google Cloud, NVIDIA, Larry Page, Sergey Brin, Jensen Huang are connected through a PARTNERED_WITH relationship. Google Cloud and NVIDIA have repeatedly expanded their partnership in AI infrastructure, software, accelerated computing, models, and developer tools.", people: ["Larry Page", "Sergey Brin", "Jensen Huang"], companies: ["Google Cloud", "NVIDIA"], entities: ["Google Cloud", "NVIDIA", "Larry Page", "Sergey Brin", "Jensen Huang"]},
  {id: "REL-003", relationship_type: "PARTNERED_WITH", applies_to: "2010-2026", source_label: "AWS and NVIDIA", description: "AWS, NVIDIA, Jeff Bezos, Jensen Huang are connected through a PARTNERED_WITH relationship. AWS and NVIDIA have collaborated since 2010 on GPU-accelerated cloud services. AWS announced that beginning in 2026 it would add more than one million NVIDIA GPUs across global cloud regions.", people: ["Jeff Bezos", "Jensen Huang"], companies: ["AWS", "NVIDIA"], entities: ["AWS", "NVIDIA", "Jeff Bezos", "Jensen Huang"]},
  {id: "REL-004", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "NVIDIA Newsroom", description: "Oracle, NVIDIA, Larry Ellison, Jensen Huang are connected through a PARTNERED_WITH relationship. Oracle and NVIDIA collaborate on accelerated computing, Oracle Cloud Infrastructure, enterprise AI, agentic AI inference, and large AI systems.", people: ["Larry Ellison", "Jensen Huang"], companies: ["Oracle", "NVIDIA"], entities: ["Oracle", "NVIDIA", "Larry Ellison", "Jensen Huang"]},
  {id: "REL-005", relationship_type: "PARTNERED_WITH", applies_to: "2024-2026", source_label: "Dell Technologies and NVIDIA", description: "Dell Technologies, NVIDIA, Michael Dell, Jensen Huang are connected through a PARTNERED_WITH relationship. Dell Technologies and NVIDIA jointly offer the Dell AI Factory with NVIDIA, combining Dell infrastructure with NVIDIA computing, networking, and software.", people: ["Michael Dell", "Jensen Huang"], companies: ["Dell Technologies", "NVIDIA"], entities: ["Dell Technologies", "NVIDIA", "Michael Dell", "Jensen Huang"]},
  {id: "REL-006", relationship_type: "LONG_TERM_INFRASTRUCTURE_PARTNERSHIP", applies_to: "2026-02-17", source_label: "Meta Newsroom", description: "Meta, NVIDIA, Mark Zuckerberg, Jensen Huang are connected through a LONG_TERM_INFRASTRUCTURE_PARTNERSHIP relationship. Meta and NVIDIA announced a multi-year strategic infrastructure partnership in February 2026 to support AI-optimized data centers, training, inference, networking, and software.", people: ["Mark Zuckerberg", "Jensen Huang"], companies: ["Meta", "NVIDIA"], entities: ["Meta", "NVIDIA", "Mark Zuckerberg", "Jensen Huang"]},
  {id: "REL-007", relationship_type: "INVESTED_IN", applies_to: "2020-04-21", source_label: "Meta Newsroom", description: "Meta, Jio Platforms, Mark Zuckerberg, Mukesh Ambani are connected through a INVESTED_IN relationship. Facebook, now Meta, announced a $5.7 billion investment in Jio Platforms in April 2020 and became its largest minority shareholder at the time.", people: ["Mark Zuckerberg", "Mukesh Ambani"], companies: ["Meta", "Jio Platforms"], entities: ["Meta", "Jio Platforms", "Mark Zuckerberg", "Mukesh Ambani"]},
  {id: "REL-008", relationship_type: "OWNS_STAKE_IN", applies_to: "2020-08-05", source_label: "Google India Blog", description: "Google, Jio Platforms, Larry Page, Sergey Brin, Mukesh Ambani are connected through a OWNS_STAKE_IN relationship. Google announced a $4.5 billion investment for a 7.73 percent stake in Jio Platforms and a commercial agreement to develop an affordable Android-based smartphone.", people: ["Larry Page", "Sergey Brin", "Mukesh Ambani"], companies: ["Google", "Jio Platforms"], entities: ["Google", "Jio Platforms", "Larry Page", "Sergey Brin", "Mukesh Ambani"]},
  {id: "REL-009", relationship_type: "USES_CLOUD_AND_AI_SERVICES_FROM", applies_to: "2021-2026", source_label: "Google Cloud", description: "LVMH, Google Cloud, Bernard Arnault, Larry Page, Sergey Brin are connected through a USES_CLOUD_AND_AI_SERVICES_FROM relationship. LVMH has worked with Google Cloud to build a secure data and AI foundation serving luxury brands across the LVMH group.", people: ["Larry Page", "Sergey Brin"], companies: ["LVMH", "Google Cloud", "Bernard Arnault"], entities: ["LVMH", "Google Cloud", "Bernard Arnault", "Larry Page", "Sergey Brin"]},
  {id: "REL-010", relationship_type: "STRATEGIC_TECHNOLOGY_PARTNERSHIP", applies_to: "2018-2024", source_label: "Microsoft", description: "Walmart, Microsoft, Walton family, Bill Gates, Steve Ballmer are connected through a STRATEGIC_TECHNOLOGY_PARTNERSHIP relationship. Walmart and Microsoft announced a five-year strategic partnership in 2018 covering cloud, AI, and Internet of Things technologies. Microsoft later described itself as a preferred and strategic cloud provider for Walmart.", people: ["Rob Walton And Family", "Jim Walton And Family", "Alice Walton", "Bill Gates", "Steve Ballmer"], companies: ["Walmart", "Microsoft"], entities: ["Walmart", "Microsoft", "Walton family", "Bill Gates", "Steve Ballmer"]},
  {id: "REL-011", relationship_type: "CLOUD_PROVIDER_AND_INVESTOR", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "Oracle, TikTok USDS, ByteDance, Larry Ellison, Zhang Yiming are connected through a CLOUD_PROVIDER_AND_INVESTOR relationship. TikTok USDS Joint Venture states that U.S. user data and its recommendation algorithm are protected in Oracle's secure U.S. cloud. Oracle is one of three managing investors, each holding 15 percent.", people: ["Larry Ellison", "Zhang Yiming"], companies: ["Oracle", "TikTok USDS", "ByteDance"], entities: ["Oracle", "TikTok USDS", "ByteDance", "Larry Ellison", "Zhang Yiming"]},
  {id: "REL-012", relationship_type: "OWNS_STAKE_IN", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "ByteDance, TikTok USDS, Zhang Yiming are connected through a OWNS_STAKE_IN relationship. ByteDance retains a 19.9 percent stake in TikTok USDS Joint Venture.", people: ["Zhang Yiming"], companies: ["ByteDance", "TikTok USDS"], entities: ["ByteDance", "TikTok USDS", "Zhang Yiming"]},
  {id: "REL-013", relationship_type: "INVESTED_IN", applies_to: "2026-01-23", source_label: "TikTok Newsroom", description: "Dell Family Office, TikTok USDS, Michael Dell, Zhang Yiming are connected through a INVESTED_IN relationship. Dell Family Office is listed as a member of the TikTok USDS Joint Venture investor consortium.", people: ["Michael Dell", "Zhang Yiming"], companies: ["Dell Family Office", "TikTok USDS"], entities: ["Dell Family Office", "TikTok USDS", "Michael Dell", "Zhang Yiming"]},
  {id: "REL-014", relationship_type: "EARLY_INVESTOR_AND_CONSORTIUM_MEMBER", applies_to: "Pre-2026 and 2026-01-23", source_label: "Forbes, Reuters, and TikTok Newsroom", description: "Susquehanna International Group, ByteDance, TikTok USDS, Jeff Yass, Zhang Yiming are connected through a EARLY_INVESTOR_AND_CONSORTIUM_MEMBER relationship. Susquehanna was an early investor in ByteDance. A Susquehanna affiliate is also part of the TikTok USDS investor consortium, and a Susquehanna managing director serves on its board.", people: ["Jeff Yass", "Zhang Yiming"], companies: ["Susquehanna International Group", "ByteDance", "TikTok USDS"], entities: ["Susquehanna International Group", "ByteDance", "TikTok USDS", "Jeff Yass", "Zhang Yiming"]},
  {id: "REL-015", relationship_type: "CHIP_SUPPLY_AGREEMENT", applies_to: "2025-07-28", source_label: "Reuters", description: "Tesla, Samsung Electronics, Elon Musk are connected through a CHIP_SUPPLY_AGREEMENT relationship. Tesla and Samsung Electronics entered a $16.5 billion semiconductor supply agreement under which Samsung's Texas facility is expected to produce Tesla's next-generation AI6 chips.", people: ["Elon Musk"], companies: ["Tesla", "Samsung Electronics"], entities: ["Tesla", "Samsung Electronics", "Elon Musk"]},
  {id: "REL-016", relationship_type: "SUPPLIER_RELATIONSHIP", applies_to: "Historical and ongoing by product generation", source_label: "Reuters and display-industry reporting", description: "Apple, Samsung Display, Samsung Electronics are connected through a SUPPLIER_RELATIONSHIP relationship. Samsung Display has supplied OLED display panels used in Apple products. This is an example of two companies that compete in consumer electronics while also maintaining a supplier-customer relationship.", people: [], companies: ["Apple", "Samsung Display", "Samsung Electronics"], entities: ["Apple", "Samsung Display", "Samsung Electronics"]},
  {id: "REL-017", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "Walmart, Amazon, Walton family, Jeff Bezos are connected through a COMPETES_WITH relationship. Walmart and Amazon compete in physical retail, e-commerce, advertising, logistics, online marketplaces, subscription programs, and delivery services.", people: ["Rob Walton And Family", "Jim Walton And Family", "Alice Walton", "Jeff Bezos"], companies: ["Walmart", "Amazon"], entities: ["Walmart", "Amazon", "Walton family", "Jeff Bezos"]},
  {id: "REL-018", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "SpaceX, Blue Origin, Elon Musk, Jeff Bezos are connected through a COMPETES_WITH relationship. SpaceX and Blue Origin compete in commercial launch services, reusable rockets, space infrastructure, government contracts, and long-term human-spaceflight ambitions.", people: ["Elon Musk", "Jeff Bezos"], companies: ["SpaceX", "Blue Origin"], entities: ["SpaceX", "Blue Origin", "Elon Musk", "Jeff Bezos"]},
  {id: "REL-019", relationship_type: "COMPETES_WITH", applies_to: "Ongoing", source_label: "Company business descriptions", description: "Google/YouTube, Meta/Instagram, ByteDance/TikTok are connected through a COMPETES_WITH relationship. YouTube, Instagram, and TikTok compete for users, creators, advertising budgets, short-form video engagement, and recommendation-driven content discovery.", people: [], companies: ["Google/YouTube", "Meta/Instagram", "ByteDance/TikTok", "Google", "YouTube", "Meta", "Instagram", "ByteDance", "TikTok"], entities: ["Google/YouTube", "Meta/Instagram", "ByteDance/TikTok"]},
  {id: "REL-020", relationship_type: "SHARED_FAMILY_OWNERSHIP", applies_to: "Ongoing", source_label: "Forbes company and billionaire profiles", description: "Charles Koch family, Julia Koch family, Koch Industries are connected through a SHARED_FAMILY_OWNERSHIP relationship. Charles Koch's family and Julia Koch's family are linked through large family ownership interests in privately held Koch Industries.", people: ["Charles Koch And Family", "Julia Koch And Family"], companies: ["Koch Industries"], entities: ["Charles Koch family", "Julia Koch family", "Koch Industries"]}
] AS rels
UNWIND rels AS rel
MERGE (f:RelationshipFact {id: rel.id})
SET f.description = rel.description,
    f.relationship_type = rel.relationship_type,
    f.applies_to = rel.applies_to,
    f.source_label = rel.source_label,
    f.entities = rel.entities,
    f.people = rel.people,
    f.companies = rel.companies
FOREACH (personName IN rel.people |
  MERGE (p:Person {name: personName})
  MERGE (p)-[:HAS_RELATIONSHIP_FACT]->(f)
)
FOREACH (companyName IN rel.companies |
  MERGE (c:Company {name: companyName})
  MERGE (c)-[:HAS_RELATIONSHIP_FACT]->(f)
);

